<h1>ログイン</h1>

<%= form_with url: top_login_path, method: :post do |f| %>
  <p>
    <%= f.label :uid, "ユーザーID" %><br>
    <%= f.text_field :uid %>
  </p>
  <p>
    <%= f.label :pass, "パスワード" %><br>
    <%= f.password_field :pass %>
  </p>
  <p>
    <%= f.submit "ログイン" %>
  </p>
<% end %>

<p><%= link_to "新規ユーザー登録はこちら", new_user_path %></p>